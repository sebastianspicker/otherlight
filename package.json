{
  "name": "exoplanet-exomoon-simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "eslint . --fix",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "install:ci": "pnpm install --frozen-lockfile",
    "ci:lint": "pnpm lint",
    "ci:typecheck": "pnpm typecheck",
    "ci:test": "pnpm test",
    "ci:build": "pnpm build",
    "ci:verify": "pnpm ci:lint && pnpm ci:typecheck && pnpm ci:test && pnpm ci:build",
    "audit:security": "pnpm audit --audit-level=high --prod",
    "audit:deps": "pnpm dlx depcheck",
    "audit:deadcode": "bash ./scripts/audit-dead-code.sh",
    "audit:full": "pnpm audit:security && pnpm audit:deps && pnpm audit:deadcode"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.1",
    "eslint": "^10.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}

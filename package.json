{
  "name": "exoplanet-exomoon-simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "eslint . --fix",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "install:ci": "pnpm install --frozen-lockfile",
    "verify-production-ready": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "turbo": "pnpm verify-production-ready"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.1",
    "eslint": "^9.19.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.22.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.0",
    "vitest": "^4.0.18"
  }
}

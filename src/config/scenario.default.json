{
  "meta": {
    "name": "Default scientific scenario",
    "version": 1,
    "schema": "SystemParams+Controls/v1",
    "units": {
      "length": "sim",
      "time": "s",
      "angles": "rad"
    },
    "notes": [
      "defaults.* use internal units (angles in radians).",
      "UI may expose degrees; use control.transform=degToRad / radToDeg accordingly.",
      "instrumentNoise is included under star.photometry because main.ts currently reads ph.instrumentNoise."
    ]
  },
  "defaults": {
    "observer": {
      "dir": { "x": 1, "y": 0, "z": 1 }
    },
    "star": {
      "r": 55,
      "photometry": {
        "cadenceSec": 60,
        "nSubsamples": 9,
        "gridRes": 220,
        "baselineFlux": 1,
        "limbDarkeningModel": {
          "default": { "kind": "quadratic", "u1": 0.35, "u2": 0.25 }
        },
        "brightnessPatches": [],
        "phaseCurve": {
          "enabled": true,
          "reflAmp": 0.001,
          "thermAmp": 0.0005,
          "reflOffset": 0,
          "thermOffset": 0,
          "lambertian": true,
          "constant": 0
        },
        "moonPhaseCurve": {
          "enabled": false,
          "reflAmp": 0,
          "thermAmp": 0,
          "lambertian": true
        },
        "forwardScattering": {
          "enabled": false,
          "amp": 0,
          "g": 0.8,
          "sigmaPhase": 0.12,
          "phaseOffset": 0,
          "gateWhenBehindStar": true,
          "clampNonNegative": true
        },
        "atmosphereTransmission": {
          "enabled": false,
          "target": "planet",
          "kind": "hard",
          "r0": 0,
          "H": 0,
          "tau0": 0
        },
        "stellarVariability": {
          "enabled": true,
          "beamingAmp": 0.00002,
          "ellipsoidalAmp": 0.00003,
          "beamingOffset": 0,
          "ellipsoidalOffset": 0,
          "constant": 0
        },
        "dayNightVisibility": {
          "enabled": false,
          "clamp": true,
          "reflectedModel": "lambert",
          "thermalModel": "constant"
        },
        "instrumentNoise": {
          "enabled": false,
          "seed": 123,
          "electronsPerUnitFlux": 1000000,
          "exposureSec": 60,
          "throughput": 1,
          "photonNoise": { "enabled": true, "gaussianApproxMinElectrons": 50 },
          "readNoise": { "enabled": false, "sigmaElectrons": 10 },
          "correlatedNoise": {
            "enabled": false,
            "sigmaFlux": 0.0001,
            "tauSec": 200
          },
          "trends": { "enabled": false }
        }
      }
    },
    "planet": {
      "r": 12,
      "m": 0,
      "orbit": {
        "a": 230,
        "e": 0.08,
        "inc": 1.3962634015954636,
        "Omega": 0,
        "omega": 0,
        "period": 18000,
        "t0": 0
      }
    },
    "moon": {
      "r": 4,
      "m": 0,
      "orbitAroundPlanet": {
        "a": 32,
        "e": 0.02,
        "inc": 0.17453292519943295,
        "Omega": 0,
        "omega": 0,
        "period": 2200,
        "t0": 0
      }
    },
    "dynamics": {
      "exomoonTimingShape": {
        "enabled": true,
        "tRef": 0,
        "velDt": 2,
        "moonOmegaDot": 0,
        "moonIncDot": 0,
        "moonOmegaSmallDot": 0,
        "moonImpactYDot": 0
